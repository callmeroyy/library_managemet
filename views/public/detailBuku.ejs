<div class="pt-24 min-h-screen bg-gray-50">
    <!-- Breadcrumb -->
    <div class="bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <nav class="flex items-center gap-2 text-sm text-gray-400">
                <a href="/" class="hover:text-blue-600 transition font-medium">Beranda</a>
                <i class="fa-solid fa-chevron-right text-xs"></i>
                <a href="/katalog" class="hover:text-blue-600 transition font-medium">Katalog</a>
                <i class="fa-solid fa-chevron-right text-xs"></i>
                <span class="text-gray-700 font-semibold truncate max-w-xs"><%= book.title %></span>
            </nav>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-10">
            <!-- Book Cover -->
            <div class="lg:col-span-2">
                <div class="sticky top-28">
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100 p-6">
                        <div class="aspect-[3/4] rounded-2xl overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center shadow-inner">
                            <% if (book.image_path) { %>
                                <img src="<%= book.image_path %>" alt="<%= book.title %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <div class="flex flex-col items-center gap-3 text-gray-300">
                                    <i class="fa-solid fa-book text-8xl"></i>
                                    <span class="text-sm font-medium">Tidak ada gambar</span>
                                </div>
                            <% } %>
                        </div>

                        <!-- Actions -->
                        <div class="mt-6 space-y-3">
                            <% if (!locals.user) { %>
                                <a href="/login" class="flex items-center justify-center gap-2 w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 rounded-2xl transition shadow-lg shadow-blue-200 hover:-translate-y-0.5 transform duration-200">
                                    <i class="fa-solid fa-right-to-bracket"></i> Login untuk Meminjam
                                </a>
                                <p class="text-center text-xs text-gray-400">Gunakan akun yang diberikan oleh admin perpustakaan</p>
                            <% } else { %>
                                <div class="flex items-center justify-center gap-2 w-full bg-blue-50 text-blue-700 font-bold py-3.5 rounded-2xl border border-blue-200">
                                    <i class="fa-solid fa-check-circle"></i> Anda Sudah Login sebagai Member
                                </div>
                                <a href="/user/pinjaman" class="flex items-center justify-center gap-2 w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-2xl transition text-sm">
                                    <i class="fa-solid fa-book-open-reader"></i> Lihat Pinjaman Saya
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Book Details -->
            <div class="lg:col-span-3">
                <!-- Category Badge -->
                <div class="inline-flex items-center gap-2 bg-blue-100 text-blue-700 text-xs font-bold px-4 py-2 rounded-full mb-4 uppercase tracking-wider">
                    <i class="fa-solid fa-tag text-xs"></i><%= book.category_name || 'Kategori' %>
                </div>

                <!-- Title -->
                <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-4"><%= book.title %></h1>

                <!-- ISBN -->
                <div class="flex items-center gap-2 mb-6 text-gray-400 text-sm">
                    <i class="fa-solid fa-barcode"></i>
                    <span class="font-mono font-medium text-gray-600">ISBN: <%= book.isbn %></span>
                </div>

                <!-- Divider -->
                <div class="h-px bg-gray-100 mb-6"></div>

                <!-- Description -->
                <div class="mb-8">
                    <h3 class="text-lg font-bold text-gray-900 mb-3 flex items-center gap-2">
                        <span class="w-1 h-5 bg-blue-600 rounded-full inline-block"></span>
                        Deskripsi Buku
                    </h3>
                    <div class="text-gray-600 leading-relaxed whitespace-pre-line text-base">
                        <%= book.description || 'Deskripsi buku ini belum tersedia. Silakan kunjungi perpustakaan untuk informasi lebih lanjut.' %>
                    </div>
                </div>

                <!-- Info Chips -->
                <div class="flex flex-wrap gap-3 mb-8">
                    <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm">
                        <i class="fa-solid fa-layer-group text-blue-500"></i>
                        <span class="text-gray-500">Kategori:</span>
                        <span class="font-bold text-gray-800"><%= book.category_name || '—' %></span>
                    </div>
                    <div class="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-4 py-2.5 text-sm">
                        <i class="fa-solid fa-barcode text-blue-500"></i>
                        <span class="text-gray-500">ISBN:</span>
                        <span class="font-bold text-gray-800 font-mono"><%= book.isbn || '—' %></span>
                    </div>
                </div>

                <!-- Back button -->
                <div class="flex items-center gap-3">
                    <a href="/katalog" class="inline-flex items-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-6 py-3 rounded-xl transition text-sm">
                        <i class="fa-solid fa-arrow-left"></i> Kembali ke Katalog
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
