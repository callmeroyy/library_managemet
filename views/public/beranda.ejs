<!-- ===================== HERO SECTION ===================== -->
<section class="hero-bg relative min-h-screen flex items-center overflow-hidden pt-16">
    <!-- Decorative Circles -->
    <div class="absolute top-20 right-10 w-72 h-72 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-20 left-10 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-600/5 rounded-full pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <!-- Left: Text -->
            <div class="text-center lg:text-left">
                <div class="inline-flex items-center gap-2 glass rounded-full px-4 py-2 mb-8 text-blue-200 text-sm font-semibold">
                    <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
                    Lebih dari 500+ Koleksi Buku Tersedia
                </div>
                <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold text-white leading-tight tracking-tight mb-6">
                    Jelajahi Dunia<br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-300 to-cyan-300">Melalui</span><br>
                    Halaman Buku
                </h1>
                <p class="text-lg text-blue-100/80 leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0">
                    Akses ribuan koleksi buku, pantau pinjaman, dan temukan bacaan baru — semuanya dalam satu platform yang mudah digunakan.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="/katalog" class="group bg-white text-blue-700 font-bold px-8 py-4 rounded-2xl hover:bg-blue-50 transition shadow-2xl text-base flex items-center justify-center gap-2 hover:-translate-y-1 transform duration-200">
                        <i class="fa-solid fa-compass group-hover:rotate-12 transition-transform duration-300"></i>
                        Eksplorasi Katalog
                    </a>
                    <a href="/login" class="group glass border border-white/20 text-white font-bold px-8 py-4 rounded-2xl hover:bg-white/15 transition text-base flex items-center justify-center gap-2 hover:-translate-y-1 transform duration-200">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Masuk ke Akun
                    </a>
                </div>
                <!-- Stats -->
                <div class="flex items-center gap-8 mt-14 justify-center lg:justify-start">
                    <div>
                        <div class="text-3xl font-extrabold text-white">500<span class="text-blue-300">+</span></div>
                        <div class="text-xs text-blue-200/70 font-medium mt-0.5">Koleksi Buku</div>
                    </div>
                    <div class="w-px h-10 bg-white/20"></div>
                    <div>
                        <div class="text-3xl font-extrabold text-white">200<span class="text-blue-300">+</span></div>
                        <div class="text-xs text-blue-200/70 font-medium mt-0.5">Anggota Aktif</div>
                    </div>
                    <div class="w-px h-10 bg-white/20"></div>
                    <div>
                        <div class="text-3xl font-extrabold text-white">15<span class="text-blue-300">+</span></div>
                        <div class="text-xs text-blue-200/70 font-medium mt-0.5">Kategori</div>
                    </div>
                </div>
            </div>

            <!-- Right: Floating Book Stack Visual -->
            <div class="relative flex items-center justify-center lg:justify-end">
                <div class="floating relative">
                    <div class="relative w-72 h-72 sm:w-96 sm:h-96">
                        <!-- Background glow -->
                        <div class="absolute inset-0 bg-blue-400/20 rounded-3xl blur-2xl"></div>
                        <!-- Main glass card -->
                        <div class="absolute inset-4 glass rounded-3xl flex flex-col items-center justify-center p-8 text-center">
                            <div class="w-20 h-20 bg-blue-500/20 rounded-2xl flex items-center justify-center mb-4 border border-blue-400/30">
                                <i class="fa-solid fa-book-open text-5xl text-blue-300"></i>
                            </div>
                            <h3 class="text-white font-bold text-lg mb-1">Baca. Pinjam. Kelola.</h3>
                            <p class="text-blue-200/70 text-sm">Platform perpustakaan digital terpadu untuk anggota</p>
                        </div>
                        <!-- Floating badges -->
                        <div class="absolute -top-4 -left-4 glass px-4 py-2.5 rounded-xl text-sm font-bold text-white flex items-center gap-2 shadow-xl">
                            <span class="text-green-400"><i class="fa-solid fa-check-circle"></i></span> Pinjam Mudah
                        </div>
                        <div class="absolute -bottom-4 -right-4 glass px-4 py-2.5 rounded-xl text-sm font-bold text-white flex items-center gap-2 shadow-xl">
                            <span class="text-yellow-400"><i class="fa-solid fa-star"></i></span> Koleksi Lengkap
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Wave bottom -->
    <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M0 80L1440 80L1440 40C1440 40 1200 0 720 0C240 0 0 40 0 40L0 80Z" fill="white"/>
        </svg>
    </div>
</section>

<!-- ===================== ABOUT SECTION ===================== -->
<section id="tentang" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <!-- Image side -->
            <div class="relative order-2 lg:order-1">
                <div class="bg-gradient-to-br from-blue-50 to-indigo-100 rounded-3xl p-8 relative overflow-hidden min-h-[420px] flex items-center justify-center">
                    <!-- Abstract library visual -->
                    <div class="absolute inset-0 opacity-10" style="background-image: repeating-linear-gradient(0deg, #3b82f6 0px, transparent 1px, transparent 40px), repeating-linear-gradient(90deg, #3b82f6 0px, transparent 1px, transparent 40px);"></div>
                    <div class="relative z-10 grid grid-cols-3 gap-4">
                        <% const colors = ['bg-red-400','bg-blue-400','bg-emerald-400','bg-yellow-400','bg-purple-400','bg-pink-400','bg-cyan-400','bg-orange-400','bg-indigo-400']; %>
                        <% for(let i = 0; i < 9; i++) { %>
                        <div class="<%= colors[i] %> rounded-xl flex flex-col items-center justify-end p-2 shadow-md" style="height: <%= 80 + (i % 3) * 25 %>px;">
                            <div class="w-2 h-2 bg-white/40 rounded-full mb-1"></div>
                        </div>
                        <% } %>
                    </div>
                    <div class="absolute -bottom-4 -right-4 w-24 h-24 bg-blue-600/10 rounded-full blur-2xl"></div>
                </div>
                <!-- Floating stat cards -->
                <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-2xl px-6 py-4 border border-gray-100 flex items-center gap-3">
                    <div class="w-10 h-10 bg-green-100 rounded-xl flex items-center justify-center">
                        <i class="fa-solid fa-users text-green-600"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-gray-900 text-lg">200+</div>
                        <div class="text-gray-500 text-xs">Anggota Terdaftar</div>
                    </div>
                </div>
            </div>

            <!-- Text side -->
            <div class="order-1 lg:order-2">
                <span class="text-blue-600 text-sm font-bold uppercase tracking-widest">Tentang Kami</span>
                <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mt-3 mb-6 leading-tight">
                    Perpustakaan untuk<br><span class="text-blue-600">Generasi Modern</span>
                </h2>
                <p class="text-gray-500 text-lg leading-relaxed mb-6">
                    Kami hadir untuk memudahkan akses ilmu pengetahuan bagi seluruh anggota. Dengan koleksi buku yang terus bertambah dan sistem digital yang modern, pengalaman membaca Anda akan semakin menyenangkan.
                </p>
                <div class="space-y-4 mb-8">
                    <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-blue-50 transition group">
                        <div class="w-10 h-10 bg-blue-100 group-hover:bg-blue-600 rounded-xl flex items-center justify-center flex-shrink-0 transition">
                            <i class="fa-solid fa-book text-blue-600 group-hover:text-white transition text-sm"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Koleksi Lengkap & Beragam</h4>
                            <p class="text-gray-500 text-sm">Ribuan judul dari berbagai kategori: fiksi, sains, teknologi, sosial, dan masih banyak lagi.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-blue-50 transition group">
                        <div class="w-10 h-10 bg-blue-100 group-hover:bg-blue-600 rounded-xl flex items-center justify-center flex-shrink-0 transition">
                            <i class="fa-solid fa-couch text-blue-600 group-hover:text-white transition text-sm"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Fasilitas Nyaman</h4>
                            <p class="text-gray-500 text-sm">Ruang baca ber-AC, koneksi WiFi cepat, dan area diskusi yang kondusif untuk semua kalangan.</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-4 p-4 bg-gray-50 rounded-xl hover:bg-blue-50 transition group">
                        <div class="w-10 h-10 bg-blue-100 group-hover:bg-blue-600 rounded-xl flex items-center justify-center flex-shrink-0 transition">
                            <i class="fa-solid fa-laptop text-blue-600 group-hover:text-white transition text-sm"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Sistem Digital Terintegrasi</h4>
                            <p class="text-gray-500 text-sm">Pantau status pinjaman, riwayat buku, dan total denda kapan saja melalui portal anggota online.</p>
                        </div>
                    </div>
                </div>
                <a href="/katalog" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-bold px-7 py-3.5 rounded-xl transition shadow-lg hover:shadow-blue-200 hover:-translate-y-0.5 transform duration-200">
                    Lihat Katalog <i class="fa-solid fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ===================== SNEAK PEEK KATALOG ===================== -->
<section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-12">
            <div>
                <span class="text-blue-600 text-sm font-bold uppercase tracking-widest">Koleksi Terbaru</span>
                <h2 class="text-4xl sm:text-5xl font-extrabold text-gray-900 mt-2">Buku Pilihan</h2>
                <p class="text-gray-500 mt-2 text-lg">Temukan buku-buku menarik yang baru saja ditambahkan ke koleksi kami.</p>
            </div>
            <a href="/katalog" class="hidden md:inline-flex items-center gap-2 text-blue-600 font-bold hover:text-blue-800 transition text-sm border border-blue-200 px-5 py-2.5 rounded-xl hover:border-blue-400 hover:bg-blue-50">
                Lihat Semua <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- Book Cards Scroll -->
        <div class="flex gap-6 overflow-x-auto scroll-cards pb-4 -mx-2 px-2">
            <% if (typeof featuredBooks !== 'undefined' && featuredBooks.length > 0) { %>
                <% featuredBooks.forEach(book => { %>
                <a href="/katalog/<%= book.id %>" class="book-card flex-shrink-0 w-48 sm:w-52 group bg-white rounded-2xl shadow-sm hover:shadow-2xl transition-all duration-400 overflow-hidden border border-gray-100 hover:-translate-y-2 transform">
                    <div class="relative h-64 bg-gradient-to-br from-gray-100 to-gray-200 overflow-hidden">
                        <% if (book.image_path) { %>
                            <img src="<%= book.image_path %>" alt="<%= book.title %>" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                        <% } else { %>
                            <div class="w-full h-full flex items-center justify-center">
                                <i class="fa-solid fa-book text-gray-400 text-5xl"></i>
                            </div>
                        <% } %>
                        <div class="book-overlay absolute inset-0 bg-blue-900/60 flex items-center justify-center">
                            <span class="bg-white text-blue-700 text-xs font-bold px-4 py-2 rounded-full shadow-lg">
                                <i class="fa-solid fa-eye mr-1"></i> Lihat Detail
                            </span>
                        </div>
                    </div>
                    <div class="p-4">
                        <span class="text-xs font-bold text-blue-500 uppercase tracking-wider"><%= book.category_name %></span>
                        <h3 class="text-sm font-bold text-gray-900 mt-1 line-clamp-2 leading-snug"><%= book.title %></h3>
                        <p class="text-xs text-gray-400 mt-2">ISBN: <%= book.isbn %></p>
                    </div>
                </a>
                <% }) %>
            <% } else { %>
                <!-- Skeleton / Placeholder Cards -->
                <% for(let i = 0; i < 5; i++) { %>
                <div class="flex-shrink-0 w-48 sm:w-52 bg-white rounded-2xl shadow-sm overflow-hidden border border-gray-100">
                    <div class="h-64 bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
                        <i class="fa-solid fa-book text-blue-200 text-5xl"></i>
                    </div>
                    <div class="p-4">
                        <div class="h-3 bg-gray-100 rounded w-16 mb-2"></div>
                        <div class="h-4 bg-gray-200 rounded w-full mb-1"></div>
                        <div class="h-4 bg-gray-200 rounded w-3/4"></div>
                    </div>
                </div>
                <% } %>
            <% } %>
        </div>

        <div class="text-center mt-8 md:hidden">
            <a href="/katalog" class="inline-flex items-center gap-2 text-blue-600 font-bold border border-blue-200 px-6 py-2.5 rounded-xl hover:bg-blue-50 transition text-sm">
                Lihat Semua Koleksi <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </div>
</section>

<!-- ===================== LOKASI SECTION ===================== -->
