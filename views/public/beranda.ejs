                        <i class="fa-solid fa-clock text-green-600 text-xl"></i>
                    </div>
                    <div>
                        <h4 class="font-bold text-gray-900 mb-2">Jam Operasional</h4>
                        <div class="space-y-1.5 text-sm">
                            <div class="flex justify-between items-center">
                                <span class="text-gray-600 font-medium">Senin – Jumat</span>
                                <span class="text-gray-900 font-bold bg-green-50 border border-green-200 px-3 py-1 rounded-full text-xs">08.00 – 16.00</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-600 font-medium">Sabtu</span>
                                <span class="text-gray-900 font-bold bg-yellow-50 border border-yellow-200 px-3 py-1 rounded-full text-xs">08.00 – 12.00</span>
                            </div>
                            <div class="flex justify-between items-center">
                                <span class="text-gray-600 font-medium">Minggu</span>
                                <span class="text-red-500 font-bold bg-red-50 border border-red-200 px-3 py-1 rounded-full text-xs">Tutup</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-gray-50 rounded-2xl p-6 flex items-start gap-4 hover:bg-blue-50 transition border border-gray-100">
                    <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center flex-shrink-0">
