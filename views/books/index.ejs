<!-- Navbar -->
<nav class="bg-white shadow-sm border-b border-gray-100 p-4 flex justify-between items-center fixed top-0 right-0 z-10 w-full">
    <div>
      <h1 class="text-xl md:text-2xl font-bold text-gray-800">Books Management</h1>
      <p class="text-gray-500 text-xs md:text-sm mt-1">Kelola koleksi buku perpustakaan</p>
    </div>
    <div class="flex items-center gap-4">
      <!-- Logout -->
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2 text-sm font-medium">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden md:inline">Logout</span>
        </button>
      </form>
    </div>
  </nav>

  <!-- Isi konten -->
  <main class="p-4 md:p-6 mt-20">
    <!-- Bar Atas -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-5 mt-2">
      <form action="/books" method="get" class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <!-- Search -->
        <div class="flex items-center bg-white rounded-xl shadow-sm border border-gray-200 w-full md:w-[260px] h-10 focus-within:ring-2 focus-within:ring-blue-100 focus-within:border-blue-400 transition-all duration-200 overflow-hidden">
          <i class="fa-solid fa-search text-gray-400 ml-3"></i>
          <input type="search" name="search" placeholder="Cari buku..." class="w-full px-3 py-2 text-sm text-gray-700 bg-transparent focus:outline-none" />
        </div>

        <!-- Dropdown Kategori -->
        <div class="relative w-full md:w-auto">
          <i class="fa-solid fa-filter absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
          <select name="categoryId" class="w-full bg-white border border-gray-200 rounded-xl pl-9 pr-8 h-10 text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-100 focus:border-blue-400 transition-all duration-200 appearance-none cursor-pointer">
            <option value="">Semua Kategori</option>
            <% categoryResult.forEach(category=> { %>
            <option value="<%= category.id %>"><%= category.name %></option>
            <% }) %>
          </select>
          <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 text-xs pointer-events-none"></i>
        </div>

        <!-- Button submit -->
        <button type="submit" class="h-10 px-4 bg-indigo-500 text-white rounded-xl hover:bg-indigo-600 hover:shadow-md transition-all duration-200 flex items-center justify-center">
          <i class="fa-solid fa-magnifying-glass text-sm"></i>
        </button>
        <!-- Button Reset -->
        <a href="/books" class="h-10 px-4 bg-gray-100 hover:bg-gray-200 text-gray-600 rounded-xl font-medium text-sm transition-all duration-200 flex items-center justify-center gap-2">
          <i class="fa-solid fa-rotate-right"></i>
          Reset
        </a>
      </form>

      <!-- Button Create -->
      <a href="books/create" class="h-10 px-5 bg-green-500 hover:bg-green-600 hover:shadow-md text-white rounded-xl font-semibold text-sm transition-all duration-200 flex items-center justify-center gap-2 w-full md:w-auto">
        <i class="fa-solid fa-plus"></i>
        Tambah Buku
      </a>
    </div>

    <!-- Grid Buku Cards -->
    <div class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-gray-50">
      <% if (searchResult.length > 0) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6 md:gap-8">
        <% searchResult.forEach(book => { %>
        <!-- Card Buku -->
        <div class="bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col h-full group">
          <!-- Gambar Buku -->
          <div class="bg-gray-50 h-48 relative overflow-hidden rounded-t-2xl">
            <img src="<%= book.image_path %>" alt="Sampul <%= book.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.outerHTML='<div class=\'w-full h-full flex flex-col items-center justify-center text-gray-400 bg-gray-100\'><i class=\'fa-solid fa-image text-3xl mb-2\'></i><span class=\'text-xs font-medium\'>No Cover</span></div>'" />
            
            <!-- Status indicator dot (Absolute top right) -->
            <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm rounded-full p-1 shadow-sm">
              <% if (book.statusBook == 1) { %> 
                <a href="/bookings/book/<%= book.id %>" class="hover:scale-110 transition-transform block" title="Tersedia (Lihat Detail)">
                  <span class="flex h-3 w-3 relative">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                  </span>
                </a>
              <% } else { %>
                <a href="/bookings/book/<%= book.id %>" class="hover:scale-110 transition-transform block" title="Sedang Dipinjam (Lihat Detail)">
                  <span class="flex h-3 w-3 relative">
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-red-500"></span>
                  </span>
                </a>
              <% } %>
            </div>
          </div>

          <!-- Info Buku -->
          <div class="p-4 flex flex-col flex-grow">
            <!-- Badge Kategori -->
            <div class="mb-2">
              <span class="inline-block bg-blue-50 text-blue-600 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider">
                <%= book.category_name %>
              </span>
            </div>
            
            <h3 class="text-base font-bold text-gray-800 mb-1 leading-snug line-clamp-2" title="<%= book.title %>"><%= book.title %></h3>
            
            <p class="text-xs text-gray-400 font-mono mb-4 mt-auto flex items-center gap-1.5">
              <i class="fa-solid fa-barcode opacity-60"></i> <%= book.isbn %>
            </p>
            
            <!-- Buttons -->
            <div class="flex gap-2 mt-auto pt-3 border-t border-gray-50">
              <a href="books/update?id=<%= book.id %>" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-1.5 rounded-lg text-sm transition-all duration-200 text-center hover:shadow-md flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-pen text-xs"></i> <span class="font-medium">Edit</span>
              </a>
              <a href="books/delete/<%= book.id %>" class="flex-1 bg-red-500 hover:bg-red-600 text-white py-1.5 rounded-lg text-sm transition-all duration-200 text-center hover:shadow-md flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-trash text-xs"></i> <span class="font-medium">Hapus</span>
              </a>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
      <% } else {%>
      <tr>
        <td colspan="4" class="text-center py-6 text-gray-500 font-medium">
          <i class="fa-solid fa-circle-exclamation text-yellow-500 mr-2"></i>
          Tidak ada data ditemukan
        </td>
      </tr>
      <% } %>

      <!-- Pagination -->
      <div class="flex items-center justify-center mt-8 gap-2">
        <!-- Previous Button -->
        <% if (page > 1) { %>
          <a href="/books?page=<%= page - 1 %>&search=<%= search %>&categoryId=<%= categoryId %>" class="px-4 py-2 bg-gray-200 text-gray-600 rounded-lg hover:bg-gray-300 transition flex items-center justify-center"><i class="fa-solid fa-chevron-left"></i></a>
        <% } else { %>
          <button disabled class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg cursor-not-allowed flex items-center justify-center"><i class="fa-solid fa-chevron-left"></i></button>
        <% } %>
      
        <!-- Page Numbers -->
        <% for(let i = 1; i <= totalPage; i++) { %>
        <a href="/books?page=<%= i %>&search=<%= search %>&categoryId=<%= categoryId %>" class="px-4 py-2 rounded-lg transition flex items-center justify-center <%= i === page ? 'bg-blue-600 text-white shadow-md' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>"><%= i %></a>
        <% } %>
      
        <!-- Next Button -->
        <% if (page < totalPage) { %>
          <a href="/books?page=<%= page + 1 %>&search=<%= search %>&categoryId=<%= categoryId %>" class="px-4 py-2 bg-gray-200 text-gray-600 rounded-lg hover:bg-gray-300 transition flex items-center justify-center"><i class="fa-solid fa-chevron-right"></i></a>
        <% } else { %>
          <button disabled class="px-4 py-2 bg-gray-100 text-gray-400 rounded-lg cursor-not-allowed flex items-center justify-center"><i class="fa-solid fa-chevron-right"></i></button>
        <% } %>
      </div>
    </div>
  </main>
