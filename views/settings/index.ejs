<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Settings</h1>
    <p class="text-gray-500 text-sm">Kelola pengaturan sistem</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden md:inline">Logout</span>
        </button>
      </form>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <div class="max-w-lg mx-auto bg-white p-6 sm:p-8 rounded-2xl shadow-lg">
    <h2 class="text-2xl sm:text-3xl font-bold text-center mb-6 text-gray-800">Pengaturan Denda</h2>
    <div class="bg-blue-50 p-4 rounded-xl mb-6 text-center">
      <p class="text-sm text-gray-600 uppercase tracking-wider font-semibold">Denda Saat Ini</p>
      <p class="text-2xl font-bold text-blue-600">Rp <%= setting.penalty_fee %></p>
    </div>

    <form action="/settings/updatePenalty" method="POST" class="space-y-6">
      <!-- Input penalty fee -->
      <div>
        <label for="penalty_fee" class="block text-gray-700 mb-2 font-semibold">Update Denda per Hari</label>
        <div class="flex items-center gap-2 bg-gray-50 border border-gray-300 rounded-lg px-4 py-3 shadow-inner focus-within:ring-2 focus-within:ring-blue-400 focus-within:border-transparent transition">
          <i class="fa-solid fa-coins text-yellow-500"></i>
          <span class="text-gray-600 font-medium">Rp</span>
          <input
            type="number"
            step="500"
            id="penalty_fee"
            name="penalty_fee"
            placeholder="Masukkan nominal baru"
            class="w-full bg-transparent text-gray-800 focus:outline-none placeholder-gray-400 font-semibold"
            required
          />
          <span class="text-gray-600 font-medium text-xs">/hari</span>
        </div>
      </div>

      <!-- Tombol simpan -->
      <div class="flex justify-center mt-8">
        <button
          type="submit"
          class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white px-10 py-3 rounded-xl font-bold shadow-lg transition duration-300 flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-floppy-disk"></i>
          Simpan Perubahan
        </button>
      </div>
    </form>

    <!-- Pesan -->
    <% if (pesan) { %>
    <div class="mt-6 text-center bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg shadow-sm animate-pulse">
      <i class="fa-solid fa-circle-check mr-2"></i>
      <%= pesan %>
    </div>
    <% } %>
  </div>
</main>