<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Bookings Management</h1>
    <p class="text-gray-500 text-sm">Kelola data peminjaman</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
    <a href="#" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span class="hidden md:inline">Logout</span>
    </a>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <!-- Filter Bar Atas -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <form action="/bookings" method="get" class="flex flex-col sm:flex-row items-center gap-4">
      <!-- Search -->
      <div class="w-full sm:flex-1 flex items-center bg-white rounded-full shadow-md overflow-hidden border border-gray-200">
        <input
          type="search"
          name="keyword"
          value="<%= typeof keyword !== 'undefined' ? keyword : '' %>"
          placeholder="Cari user atau buku"
          class="w-full px-4 py-2 text-gray-700 bg-transparent focus:outline-none"
        />
        <button class="px-4 py-2 bg-indigo-500 text-white font-semibold hover:bg-indigo-600 transition duration-300">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>

      <!-- Dropdown Status -->
      <select
        name="status"
        class="w-full sm:w-auto px-4 py-2 bg-white border-2 border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 shadow-sm transition cursor-pointer"
      >
        <option value="" <%= status === '' ? 'selected' : '' %>>Semua history</option>
        <option value="users" <%= status === 'users' ? 'selected' : '' %>>Users</option>
        <option value="books" <%= status === 'books' ? 'selected' : '' %>>Books</option>
      </select>

      <!-- Button Reset -->
      <a href="/bookings" class="w-full sm:w-auto bg-gray-200 hover:bg-gray-300 text-gray-700 px-5 py-2 rounded-lg font-semibold transition text-center">
        <i class="fa-solid fa-rotate-right mr-2"></i>
        Reset
      </a>
    </form>

    <!-- Button Create -->
    <div class="lg:justify-self-end">
      <a href="/bookings/create" class="inline-block bg-green-500 hover:bg-green-600 text-white px-5 py-3 rounded-lg font-semibold transition">
        <i class="fa-solid fa-plus mr-2"></i>
        Tambah Peminjaman
      </a>
    </div>
  </div>

  <div class="bg-white p-6 rounded-xl shadow-lg">
    <!-- Tabel Peminjaman -->
    <% if (status === "" || status === "all") { %>
      <!-- Info Total -->
      <div class="bg-blue-50 p-4 rounded-lg mb-6 inline-block">
        <p class="text-sm text-gray-600">Total Buku Dipinjam</p>
        <p class="text-2xl font-bold text-blue-600">
          <%= typeof result !== 'undefined' ? result : 0 %> Buku / <%= Array.isArray(resultSearch) ? resultSearch.length : 0 %> Peminjam
        </p>
      </div>

      <div class="bg-gray-50 p-4 sm:p-6 rounded-lg">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Daftar Peminjaman</h3>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-200">
                <th class="text-center p-3 font-semibold text-gray-700">No</th>
                <th class="text-left p-3 font-semibold text-gray-700">Nama Peminjam</th>
                <th class="text-left p-3 font-semibold text-gray-700">Judul Buku</th>
                <th class="text-left p-3 font-semibold text-gray-700">Tgl Pinjam</th>
                <th class="text-left p-3 font-semibold text-gray-700">Tgl Kembali</th>
                <th class="text-center p-3 font-semibold text-gray-700">Status</th>
                <th class="text-center p-3 font-semibold text-gray-700">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% (resultSearch || []).forEach((result, index) => { %>
                <tr class="border-b hover:bg-gray-100">
                  <td class="p-3 text-center">
                    <span class="text-gray-800"><%= (page - 1) * limit + index + 1 %></span>
                  </td>
                  <td class="p-3">
                    <div class="flex items-center gap-2">
                      <div class="bg-blue-500 text-white w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0">
                        <i class="fa-solid fa-user"></i>
                      </div>
                      <span class="truncate max-w-[150px]"><%= result.user_name %></span>
                    </div>
                  </td>
                  <td class="p-3"><span class="truncate block max-w-[200px]"><%= result.books %></span></td>
                  <td class="p-3 whitespace-nowrap"><%= result.startDate %></td>
                  <td class="p-3 whitespace-nowrap"><%= result.endDate %></td>
                  <td class="p-3 text-center">
                    <% 
                      let colorClass = 
                        result.status === "Dipinjam" ? "bg-yellow-200 text-yellow-800" :
                        result.status === "Terlambat" ? "bg-red-200 text-red-800" :
                        "bg-green-200 text-green-800";
                    %>
                    <span class="<%= colorClass %> px-3 py-1 rounded-full text-xs font-semibold whitespace-nowrap">
                      <%= result.status %>
                    </span>
                  </td>
                  <td class="p-3">
                    <div class="flex justify-center">
                      <% if (result.status === "Dipinjam") { %>
                        <a href="/bookings/returnBook?id=<%= result.bookings_id %>" 
                           class="bg-green-500 hover:bg-green-600 text-white px-3 py-1 rounded text-sm flex items-center gap-2 whitespace-nowrap">
                          <i class="fa-solid fa-check"></i>
                          <span>Kembalikan</span>
                        </a>
                      <% } else { %>
                        <button class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded text-sm flex items-center gap-2">
                          <i class="fa-solid fa-eye"></i>
                          <span>Detail</span>
                        </button> 
                      <% } %>
                    </div>
                  </td> 
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    <% } else if (status === "users") { %>
      <div class="bg-gray-50 p-6 rounded-lg">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Daftar History Users</h3>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-200">
                <th class="text-center p-3 font-semibold text-gray-700">No</th>
                <th class="text-left p-3 font-semibold text-gray-700">Nama Peminjam</th>
                <th class="text-center p-3 font-semibold text-gray-700">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% (resultSearch || []).forEach((result, index) => { %>
                <tr class="border-b hover:bg-gray-100">
                  <td class="p-3 text-center">
                    <span class="text-gray-800"><%= (page - 1) * limit + index + 1 %></span>
                  </td>
                  <td class="p-3">
                    <div class="flex items-center gap-2">
                      <div class="bg-blue-500 text-white w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold shrink-0">
                        <i class="fa-solid fa-user"></i>
                      </div>
                      <span><%= result.user_name %></span>
                    </div>
                  </td>    
                  <td class="p-3">
                    <div class="flex justify-center">
                      <a href="/bookings/user/<%= result.id %>" 
                         class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
                        <i class="fa-solid fa-eye"></i>
                        <span>Detail</span>
                      </a>
                    </div> 
                  </td> 
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

    <% } else { %>
      <div class="bg-gray-50 p-6 rounded-lg">
        <h3 class="text-lg font-bold text-gray-800 mb-4">Daftar Peminjaman</h3>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="bg-gray-200">
                <th class="text-center p-3 font-semibold text-gray-700">No</th>
                <th class="text-left p-3 font-semibold text-gray-700">ISBN Buku</th>
                <th class="text-left p-3 font-semibold text-gray-700">Nama Buku</th>
                <th class="text-center p-3 font-semibold text-gray-700">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% (resultSearch || []).forEach((result, index) => { %>
                <tr class="border-b hover:bg-gray-100">
                  <td class="p-3 text-center">
                    <span class="text-gray-800"><%= (page - 1) * limit + index + 1 %></span>
                  </td>
                  <td class="p-3 font-mono"><%= result.isbn %></td>    
                  <td class="p-3"><%= result.title %></td>    
                  <td class="p-3">
                    <div class="flex justify-center">
                      <a href="/bookings/book/<%= result.id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2">
                        <i class="fa-solid fa-eye"></i>
                        <span>Detail</span>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
    
    <!-- Pagination -->
    <div class="flex items-center justify-center mt-8 gap-2">
      <% if (totalPage > 0) { %>
        <% for(let i = 1; i <= totalPage; i++) { %>
        <a href="/bookings?page=<%= i %>&keyword=<%= keyword %>&status=<%= status %>" class="px-4 py-2 rounded-lg transition duration-200 <%= i == page ? 'bg-blue-600 text-white shadow-md' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>"><%= i %></a>
        <% } %>
      <% } %>
    </div>
  </div>
</main>