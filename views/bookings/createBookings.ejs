<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Bookings Management</h1>
    <p class="text-gray-500 text-sm">Kelola data Peminjaman</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden md:inline">Logout</span>
        </button>
      </form>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <div class="bg-white p-6 pb-20 rounded-xl shadow-lg flex justify-center items-center flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold text-gray-800">Create New Booking</h3>
    </div>

    <!-- Form -->
    <form action="/bookings/create" method="post" class="space-y-4 w-full max-w-lg mx-auto">
      <!-- User -->
      <div>
        <label class="block text-gray-600 mb-1">Pilih User</label>
        <select name="user_id" class="w-full border border-gray-300 px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white">
          <% users.forEach(user => { %>
          <option value="<%= user.id %>"><%= user.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- Buku -->
      <div>
        <label class="block text-gray-600 mb-1">Pilih Buku</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-48 overflow-y-auto p-3 border border-gray-300 rounded-lg">
          <% books.forEach(book => { %>
          <label class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded transition">
            <input type="checkbox" name="book_ids" value="<%= book.id %>" class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500" />
            <span class="text-sm text-gray-700 truncate"><%= book.title %></span>
          </label>
          <% }) %>
        </div>
      </div>

      <!-- Tanggal -->
      <div>
        <label class="block text-gray-600 mb-1">Tanggal Selesai Pinjam</label>
        <input type="date" name="end_date" class="w-full border border-gray-300 px-4 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>

      <!-- Error Message -->
      <% if (pesan) { %>
        <div class="w-full mt-4">
          <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-center font-medium">
            <strong class="font-bold">Error!</strong> <%= pesan %>
          </div>
        </div>
      <% } %>

      <!-- Tombol -->
      <div class="flex flex-col sm:flex-row justify-between gap-3 pt-4">
        <a href="/bookings" class="w-full sm:w-auto px-5 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition text-center font-semibold">Cancel</a>
        <button type="submit" class="w-full sm:w-auto px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-semibold">Simpan</button>
      </div>
    </form>
  </div>
</main>