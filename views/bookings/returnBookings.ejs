<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Bookings Management</h1>
    <p class="text-gray-500 text-sm">Kelola data Peminjaman</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
          <i class="fa-solid fa-right-from-bracket"></i>
          <span class="hidden md:inline">Logout</span>
        </button>
      </form>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <div class="bg-white p-6 pb-20 rounded-xl shadow-lg flex justify-center items-center flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold text-gray-800">Return Booking</h3>
    </div>

    <!-- Form -->
    <form action="/bookings/returnBook" method="post" class="space-y-4 w-full max-w-lg mx-auto">
      <input type="hidden" name="id" value="<%= id %>">
      
      <!-- User Info -->
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <label class="block text-sm font-semibold text-gray-600 mb-1">Nama Peminjam</label>
        <p class="text-gray-800 font-medium"><%= name %></p>
      </div>

      <!-- Book Info -->
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <label class="block text-sm font-semibold text-gray-600 mb-2">Buku yang Dipinjam</label>
        <ul class="list-disc list-inside space-y-1">
          <% books.forEach((r, index) => { %>
            <li class="text-gray-700 text-sm truncate"><%= r.title %></li>
          <% }) %>
        </ul>
      </div>
      
      <!-- Penalty Fee Info -->
      <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
        <label class="block text-sm font-semibold text-gray-600 mb-2">Informasi Denda</label>
        <% if (actual.isAfter(end)) { %>
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Denda Per Hari</span>
              <span class="font-semibold">Rp <%= penalty_fee %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Total Buku</span>
              <span class="font-semibold"><%= totalBooks %> Buku</span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Terlambat</span>
              <span class="text-red-500 font-bold"><%= dayPenalty %> Hari</span>
            </div>
            <hr class="border-gray-200">
            <div class="flex justify-between items-center">
              <span class="font-semibold text-gray-800">Total Denda</span>
              <span class="text-red-600 font-bold text-lg">Rp <%= fee %></span>
              <input type="hidden" name="fee" value="<%= fee %>">
            </div>
          </div>
        <% } else { %>
          <p class="text-green-600 font-medium flex items-center gap-2">
            <i class="fa-solid fa-circle-check"></i>
            Tidak ada denda (Tepat Waktu)
          </p>
        <% } %>
      </div>

      <!-- Dates -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-lg border border-gray-200">
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tgl Pinjam</label>
          <p class="text-sm text-gray-700 font-medium"><%= startDate %></p>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tgl Kembali (Seharusnya)</label>
          <p class="text-sm text-gray-700 font-medium"><%= endDate %></p>
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wider">Tgl Dikembalikan (Hari ini)</label>
          <p class="text-sm text-blue-600 font-bold"><%= actualDate %></p>
        </div>
      </div>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row justify-between gap-3 pt-4">
        <a href="/bookings" class="w-full sm:w-auto px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition text-center font-semibold">Cancel</a>
        <button type="submit" class="w-full sm:w-auto px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-bold shadow-md">Confirm Return</button>
      </div>
    </form>
  </div>
</main>
