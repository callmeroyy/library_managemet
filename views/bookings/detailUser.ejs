<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Booking Details</h1>
    <p class="text-gray-500 text-sm">Detail riwayat user</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
    <a href="#" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span class="hidden md:inline">Logout</span>
    </a>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <!-- Profile Card -->
  <div class="bg-white rounded-xl shadow-md p-6 md:p-8 mb-6 flex flex-col sm:flex-row items-center gap-6">
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white w-20 h-20 rounded-full flex items-center justify-center shadow-lg shrink-0">
      <i class="fa-solid fa-user text-4xl"></i>
    </div>
    <div class="text-center sm:text-left">
      <h2 class="text-2xl font-bold text-gray-800"><%= result[0].name %></h2>
      <p class="text-gray-600"><%= result[0].email %></p>
      <div class="mt-2 flex justify-center sm:justify-start">
        <% if (result[0].is_active == 1) { %>
          <span class="bg-green-100 text-green-700 text-xs font-bold px-3 py-1 rounded-full">Active Member</span>
        <% } else { %>
          <span class="bg-red-100 text-red-700 text-xs font-bold px-3 py-1 rounded-full">Inactive</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Statistics Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Buku yang Masih Dipinjam -->
    <div class="bg-white rounded-xl shadow-md p-6 flex flex-col">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="bg-blue-100 p-3 rounded-lg text-blue-600">
            <i class="fa-solid fa-book-open text-2xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-800">Peminjaman Aktif</h3>
        </div>
        <span class="bg-blue-500 text-white text-xl font-bold px-4 py-1 rounded-lg"><%= totalDipinjam %></span>
      </div>
        
      <div class="space-y-3 flex-grow">
        <% if (result.length > 0 && result[0].start_date != null) { %>
          <% result.forEach(book => { %>
            <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100 transition sm:flex sm:items-center sm:justify-between sm:gap-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-0">
                <i class="fa-solid fa-book text-blue-500 shrink-0"></i>
                <div class="truncate">
                  <p class="font-bold text-gray-800 truncate"><%= book.books %></p>
                  <p class="text-xs text-gray-500 font-mono"><%= book.isbns %></p>
                  <p class="text-xs text-gray-400">Pinjam: <%= book.startDate %></p>
                </div>
              </div>

              <div class="text-right shrink-0">
                <% if (book.remainingTime >= 0) { %> 
                  <span class="inline-block text-xs font-bold <%= book.remainingTime > 2 ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %> px-2 py-1 rounded whitespace-nowrap">
                    <%= book.remainingTime %> hari lagi
                  </span>
                <% } else { %>
                  <span class="inline-block text-xs font-bold bg-red-100 text-red-700 px-2 py-1 rounded whitespace-nowrap text-animate-pulse">
                    Terlambat <%= book.dayPenalty %> hari
                  </span>
                <% } %>
              </div>
            </div>
          <% }) %> 
        <% } else { %>
          <div class="text-center py-8">
            <i class="fa-solid fa-face-smile text-gray-300 text-5xl mb-3"></i>
            <p class="text-gray-500 font-medium">Tidak ada peminjaman aktif.</p>
          </div>
        <% } %>
      </div>
      
      <div class="mt-6 pt-6 border-t border-gray-100">
        <% if (result[0].start_date != null) { %>  
          <a href="/bookings?keyword=<%= result[0].name %>" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl transition duration-200 font-bold shadow-md">Kembalikan Buku</a>
        <% } else { %>
          <a href="/bookings/create" class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-xl transition duration-200 font-bold shadow-md">Buat Pinjaman Baru</a>
        <% } %>
      </div>
    </div>

    <!-- Buku yang Sudah Dikembalikan -->
    <div class="bg-white rounded-xl shadow-md p-6 flex flex-col">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
          <div class="bg-green-100 p-3 rounded-lg text-green-600">
            <i class="fa-solid fa-history text-2xl"></i>
          </div>
          <h3 class="text-lg font-bold text-gray-800">Riwayat Pengembalian</h3>
        </div>
        <span class="bg-green-500 text-white text-xl font-bold px-4 py-1 rounded-lg"><%= bookReturn.length %></span>
      </div>

      <div class="space-y-3 flex-grow max-h-[400px] overflow-y-auto pr-2">
        <% if (bookReturn.length > 0) { %>
          <% bookReturn.forEach(book => { %>
            <div class="p-4 bg-gray-50 rounded-lg border border-gray-100 hover:bg-gray-100 transition sm:flex sm:items-center sm:justify-between sm:gap-4">
              <div class="flex items-center gap-3 mb-2 sm:mb-0">
                <i class="fa-solid fa-circle-check text-green-500 shrink-0"></i>
                <div class="truncate">
                  <p class="font-bold text-gray-800 truncate"><%= book.books %></p>
                  <p class="text-[10px] text-gray-400">Jatuh Tempo: <%= book.endDate %></p>
                  <p class="text-[10px] text-blue-500 font-semibold">Kembali: <%= book.actualReturnDate %></p>
                </div>
              </div>
              <div class="text-right shrink-0">
                <% if (book.status == "Tepat Waktu") { %>
                  <span class="inline-block text-[10px] font-bold bg-green-100 text-green-700 px-2 py-1 rounded uppercase tracking-wider">Tepat Waktu</span>
                <% } else if (book.status == "Terlambat") { %>
                  <span class="inline-block text-[10px] font-bold bg-red-100 text-red-700 px-2 py-1 rounded uppercase tracking-wider">Terlambat</span>
                <% } else { %>
                  <span class="inline-block text-[10px] font-bold bg-yellow-100 text-yellow-700 px-2 py-1 rounded uppercase tracking-wider">Aktif</span>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-8">
            <i class="fa-solid fa-clock-rotate-left text-gray-300 text-5xl mb-3"></i>
            <p class="text-gray-500 font-medium">Belum ada riwayat pengembalian.</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</main>
