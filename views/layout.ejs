<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  </head>
  <body class="bg-gray-300 overflow-hidden">
    <!-- Sidebar Toggle Button -->
    <button id="sidebarToggle" class="fixed top-5 left-5 z-[60] p-3 bg-white text-gray-800 rounded-xl shadow-lg hover:bg-gray-100 transition-all focus:outline-none">
      <i class="fa-solid fa-bars text-xl"></i>
    </button>

    <!-- Backdrop overlay for mobile -->
    <div id="sidebarBackdrop" class="fixed inset-0 bg-black/50 z-40 hidden backdrop-blur-sm transition-opacity duration-300 opacity-0"></div>

    <style>
      /* Sidebar styling overrides for toggle functionality */
      #sidebar {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 50;
      }
      
      #content-wrapper {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        width: 100%;
      }

      /* Desktop behavior: push content */
      @media (min-width: 768px) {
        .sidebar-collapsed #sidebar {
          transform: translateX(-100%);
        }

        .sidebar-collapsed #content-wrapper {
          margin-left: 0 !important;
          width: 100%;
        }

        /* Default desktop state when sidebar is open */
        body:not(.sidebar-collapsed) #content-wrapper {
          margin-left: 16rem; /* space for sidebar */
          width: calc(100% - 16rem);
        }

        body:not(.sidebar-collapsed) #content-wrapper nav {
          left: 16rem !important;
        }

        .sidebar-collapsed #content-wrapper nav {
          left: 0 !important;
        }
      }

      /* Mobile behavior: overlay */
      @media (max-width: 767px) {
        #sidebar {
          transform: translateX(-100%);
        }
        
        #content-wrapper {
          margin-left: 0 !important;
          width: 100%;
        }

        /* When open on mobile */
        body.sidebar-open #sidebar {
          transform: translateX(0);
        }

        body.sidebar-open #sidebarBackdrop {
          display: block;
          opacity: 1;
        }
      }

      .sidebar-collapsed #sidebarToggle {
        left: 1.25rem;
      }
    </style>

	<div class="flex h-screen overflow-hidden">
        <%- include('partials/navbar') %>
        
        <div id="content-wrapper" class="flex-1 flex flex-col relative overflow-y-auto">
            <%- include(content) %>
        </div>
    </div>
  <script>
    const sidebarToggle = document.getElementById('sidebarToggle');
    const backdrop = document.getElementById('sidebarBackdrop');
    const body = document.body;
    const toggleIcon = sidebarToggle.querySelector('i');

    function toggleSidebar() {
      const isMobile = window.innerWidth < 768;
      
      if (isMobile) {
        body.classList.toggle('sidebar-open');
        const isOpen = body.classList.contains('sidebar-open');
        
        // Handle backdrop
        if (isOpen) {
          backdrop.classList.remove('hidden');
          setTimeout(() => backdrop.classList.add('opacity-100'), 10);
        } else {
          backdrop.classList.remove('opacity-100');
          setTimeout(() => backdrop.classList.add('hidden'), 300);
        }
        
        updateIcon(isOpen);
      } else {
        body.classList.toggle('sidebar-collapsed');
        updateIcon(body.classList.contains('sidebar-collapsed'));
      }
    }

    function updateIcon(isClosedOrOpenMobile) {
      if (isClosedOrOpenMobile) {
        toggleIcon.classList.remove('fa-bars');
        toggleIcon.classList.add('fa-xmark');
      } else {
        toggleIcon.classList.remove('fa-xmark');
        toggleIcon.classList.add('fa-bars');
      }
    }

    sidebarToggle.addEventListener('click', toggleSidebar);
    backdrop.addEventListener('click', toggleSidebar);

    // Close sidebar when window is resized to desktop from open mobile
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && body.classList.contains('sidebar-open')) {
        body.classList.remove('sidebar-open');
        backdrop.classList.add('hidden');
        backdrop.classList.remove('opacity-100');
        updateIcon(body.classList.contains('sidebar-collapsed'));
      }
    });
  </script>
</body>
</html>