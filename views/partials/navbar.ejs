<!-- Sidebar -->
<aside id="sidebar" class="w-64 bg-gradient-to-b from-gray-800 to-gray-900 shadow-2xl h-screen p-6 pt-24 text-white fixed left-0 top-0 flex flex-col">
  <!-- Logo/Header -->
  <div class="text-center mb-8">
    <div class="bg-blue-500 w-16 h-16 rounded-full mx-auto mb-3 flex items-center justify-center">
      <i class="fa-solid fa-book-open text-2xl"></i>
    </div>
    <h2 class="text-2xl font-bold">Perpustakaan</h2>
    <p class="text-gray-400 text-sm">Admin Panel</p>
  </div>

  <!-- Menu -->
  <ul class="space-y-2 flex-1">
    <li>
      <a href="/dashboard" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/dashboard') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/dashboard')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-house w-5"></i>
        <span class="font-medium">Dashboard</span>
      </a>
    </li>
    <li>
      <a href="/users" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/users') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/users')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-users w-5"></i>
        <span class="font-medium">Users</span>
      </a>
    </li>
    <li>
      <a href="/categories" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/categories') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/categories')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-tags w-5"></i>
        <span class="font-medium">Kategori</span>
      </a>
    </li>
    <li>
      <a href="/books" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/books') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/books')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-book w-5"></i>
        <span class="font-medium">Buku</span>
      </a>
    </li>
    <li>
      <a href="/bookings" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/bookings') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/bookings')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-handshake w-5"></i>
        <span class="font-medium">Peminjaman</span>
      </a>
    </li>
    <li>
      <a href="/settings" class="relative flex items-center gap-3 p-3 rounded-lg transition-all duration-300 <%= path.startsWith('/settings') ? 'bg-blue-600 text-white shadow-md' : 'text-gray-300 hover:bg-gray-700/60 hover:text-white hover:translate-x-1' %>">
        <% if (path.startsWith('/settings')) { %> <span class="absolute left-0 top-1/2 -translate-y-1/2 w-1.5 h-8 bg-white rounded-r-md"></span> <% } %>
        <i class="fa-solid fa-gear w-5"></i>
        <span class="font-medium">Settings</span>
      </a>  
    </li>
  </ul>

  <!-- Logout di kiri bawah -->
  <div class="border-t border-gray-700/50 pt-4 mt-4">
    <form action="/logout" method="POST">
      <button type="submit" class="flex items-center gap-3 w-full p-3 rounded-lg text-gray-400 hover:bg-red-600/20 hover:text-red-400 transition-all duration-300">
        <i class="fa-solid fa-right-from-bracket w-5"></i>
        <span class="font-medium">Logout</span>
      </button>
    </form>
  </div>
</aside>