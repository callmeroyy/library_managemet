<!-- Navbar -->
<nav class="bg-white shadow-md p-4 flex justify-between items-center fixed top-0 right-0 z-10">
  <div>
    <h1 class="text-2xl font-bold text-gray-800">Users Management</h1>
    <p class="text-gray-500 text-sm">Kelola data pengguna</p>
  </div>
  <div class="flex items-center gap-4">
    <!-- Logout -->
    <a href="#" class="bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded-lg transition duration-200 flex items-center gap-2">
      <i class="fa-solid fa-right-from-bracket"></i>
      <span class="hidden md:inline">Logout</span>
    </a>
  </div>
</nav>

<!-- Isi konten -->
<main class="p-4 md:p-6 mt-20">
  <div class="bg-white p-6 pb-20 rounded-xl shadow-lg flex justify-center items-center flex-col">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-xl font-bold text-gray-800">Update User</h3>
    </div>

    <!-- Form -->
    <form action="/users/update?id=<%= id %>" method="POST" class="space-y-4 w-full max-w-lg">
      <div>
        <label class="block text-gray-600 mb-1">Nama</label>
        <input type="text" placeholder="Masukkan nama" name="newName" id="newName" value="<%= name %>" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>
      <div>
        <label class="block text-gray-600 mb-1">Email</label>
        <input type="email" value="<%= email %>" placeholder="Masukkan email" name="newEmail" id="newEmail" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>
      <div>
        <label class="block text-gray-600 mb-1">Password Sebelumnya</label>
        <small class="text-gray-500 block mb-1">* jika tidak ingin mengganti password, biarkan kosong</small>
        <input type="password" placeholder="Masukkan password" name="newPassword" id="newPassword" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400" />
      </div>  
      <!-- Tombol -->
      <div class="flex justify-end gap-3 pt-4">
        <a type="button" href="/users" class="px-5 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition">Cancel</a>
        <button type="submit" class="px-5 py-2 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition">Simpan</button>
      </div>
      <% if (pesan) { %>
      <div class="w-full mt-4">
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded text-center font-medium"><%= pesan %></div>
      </div>
      <% } %>
    </form>
  </div>
</main>
